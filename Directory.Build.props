<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NepplyRuntimeVersion>10.0.14</NepplyRuntimeVersion>
    <NepplyILLinkVersion>10.0.10</NepplyILLinkVersion>
    <!-- Projects targeting net10.0-windows10.0.19041.0 clear this so Microsoft.Windows.SDK.NET.Ref keeps its own SDK version while Directory.Build.targets pins .NET/WPF packs. -->
    <RuntimeFrameworkVersion>$(NepplyRuntimeVersion)</RuntimeFrameworkVersion>
    <Deterministic>true</Deterministic>
    <Authors>Minh Quang</Authors>
    <Company>Minh Quang</Company>
    <Copyright>Copyright (c) 2026 Minh Quang</Copyright>
    <!-- Strips machine paths from binaries so a build output does not depend on the checkout folder. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
