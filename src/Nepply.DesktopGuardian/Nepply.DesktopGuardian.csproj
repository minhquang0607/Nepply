<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Task Manager shows the file description; name the helper's job, not its assembly. -->
    <AssemblyTitle>Nepply Desktop icon guardian</AssemblyTitle>
    <Product>Nepply</Product>
    <!-- The app refuses a guardian whose file version differs. Keep equal to Nepply.csproj (Test-ReleaseLayout checks). -->
    <Version>2.0.0-rc.1</Version>
    <FileVersion>2.0.0.1</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Nepply/Features/Desktop/Visibility/DesktopGuardianFence.cs" Link="Shared/DesktopGuardianFence.cs" />
    <Compile Include="../Nepply/Platform/Windows/Startup/ProcessPackageIdentity.cs" Link="Shared/ProcessPackageIdentity.cs" />
    <Compile Include="../Nepply/Features/Desktop/Visibility/DesktopRecoverySession.cs" Link="Shared/DesktopRecoverySession.cs" />
    <Compile Include="../Nepply/Features/Desktop/Visibility/DesktopRecoveryJournal.cs" Link="Shared/DesktopRecoveryJournal.cs" />
    <Compile Include="../Nepply/Features/Desktop/Visibility/ExplorerDesktopVisibility.cs" Link="Shared/ExplorerDesktopVisibility.cs" />
    <Compile Include="../Nepply/Platform/Windows/HelperPipeIdentity.cs" Link="Shared/HelperPipeIdentity.cs" />
  </ItemGroup>
</Project>
