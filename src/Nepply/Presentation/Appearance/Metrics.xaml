<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nepply.Modules.Appearance" xmlns:views="clr-namespace:Nepply.Views">
 <Style x:Key="MetricCard" TargetType="Border">
  <Setter Property="views:MetallicSurface.Accent" Value="{DynamicResource AccentSourceBrush}"/>
  <Setter Property="Background" Value="{DynamicResource CardSheenBrush}"/>
  <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/><Setter Property="Padding" Value="{DynamicResource PaddingMetric}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="0.5"/>
  <Style.Triggers><Trigger Property="local:PresentationDensity.Compact" Value="True">
   <Setter Property="Padding" Value="{DynamicResource PaddingMetricCompact}"/><Setter Property="CornerRadius" Value="{DynamicResource RadiusCompactCard}"/>
  </Trigger></Style.Triggers>
 </Style>
 <Style x:Key="MetricValue" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="FontSize" Value="{DynamicResource FontSizeMetric}"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Typography.NumeralAlignment" Value="Tabular"/><Setter Property="Typography.NumeralStyle" Value="Lining"/>
  <Style.Triggers><Trigger Property="local:PresentationDensity.Compact" Value="True"><Setter Property="FontSize" Value="{DynamicResource FontSizeMetricCompact}"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="MetricReading" TargetType="FrameworkElement">
  <Setter Property="Margin" Value="{DynamicResource MarginMetricReading}"/>
  <Style.Triggers><Trigger Property="local:PresentationDensity.Compact" Value="True"><Setter Property="Margin" Value="{DynamicResource MarginMetricReadingCompact}"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="MetricSecondary" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}"/>
  <Style.Triggers><Trigger Property="local:PresentationDensity.Compact" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
 </Style>
</ResourceDictionary>
