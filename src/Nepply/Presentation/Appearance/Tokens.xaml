<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
 <!-- Role-based constants preserve current geometry; density remains a view decision. -->
 <CornerRadius x:Key="RadiusIsland">26</CornerRadius>
 <CornerRadius x:Key="RadiusCard">20</CornerRadius>
 <CornerRadius x:Key="RadiusCompactCard">14</CornerRadius>
 <CornerRadius x:Key="RadiusInput">12</CornerRadius>
 <CornerRadius x:Key="RadiusTile">11</CornerRadius>
 <CornerRadius x:Key="RadiusAction">15</CornerRadius>
 <CornerRadius x:Key="RadiusTray">23</CornerRadius>
 <Thickness x:Key="PaddingMetric">12</Thickness>
 <Thickness x:Key="PaddingMetricCompact">8,6</Thickness>
 <Thickness x:Key="PaddingSection">20</Thickness>
 <Thickness x:Key="MarginPanelHeader">20,20,16,18</Thickness>
 <Thickness x:Key="MarginMetricReading">0,8,0,10</Thickness>
 <Thickness x:Key="MarginMetricReadingCompact">0,2,0,3</Thickness>
 <sys:Double x:Key="FontSizeMetric">25</sys:Double>
 <sys:Double x:Key="FontSizeMetricCompact">20</sys:Double>
 <sys:Double x:Key="FontSizeCaption">11</sys:Double>
 <sys:Double x:Key="FontSizeSecondary">10</sys:Double>
 <Style x:Key="NumericText" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
  <Setter Property="Typography.NumeralStyle" Value="Lining"/>
 </Style>
</ResourceDictionary>
