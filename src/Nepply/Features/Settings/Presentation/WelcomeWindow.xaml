<Window x:Class="Nepply.Views.WelcomeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Nepply.Views"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="{DynamicResource Loc.WelcomeTitle}" Icon="/Nepply;component/Resources/icon.ico" Width="560" Height="650" MinWidth="460" MinHeight="480"
 WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource SurfaceBrush}">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="16" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border Padding="28" Background="{DynamicResource IslandBrush}" CornerRadius="22"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Background="Transparent" MouseLeftButtonDown="DragTitle" Margin="0,0,0,22">
   <StackPanel Orientation="Horizontal"><Image Width="36" Height="36" Margin="0,0,10,0" Source="/Nepply;component/Resources/nepply.png" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="nepply" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Close_Click" AutomationProperties.Name="{DynamicResource Loc.Close}" ToolTip="{DynamicResource Loc.Close}"/>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,8,0">
    <Border CornerRadius="22" Padding="22" Margin="0,0,0,20" Background="{DynamicResource CardSheenBrush}" local:MetallicSurface.Accent="{DynamicResource AccentSourceBrush}">
     <StackPanel>
      <TextBlock Text="{DynamicResource Loc.WelcomeHero}" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{DynamicResource Loc.WelcomeReveal}" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
    <TextBlock Text="{DynamicResource Loc.WelcomePosition}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <ComboBox x:Name="EdgeChoice" AutomationProperties.Name="{DynamicResource Loc.WelcomePosition}"/>
    <CheckBox x:Name="HideIcons" Margin="0,18,0,6"><TextBlock Text="{DynamicResource Loc.WelcomeHideIcons}" TextWrapping="Wrap"/></CheckBox>
    <TextBlock Text="{DynamicResource Loc.WelcomeRecovery}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
    <Border Background="{DynamicResource HoverBrush}" CornerRadius="14" Padding="16" Margin="0,20,0,12">
     <StackPanel>
      <TextBlock x:Name="HotkeyHint" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{DynamicResource Loc.WelcomeTips}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,16,0,0">
   <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
   <Button x:Name="StartButton" Content="{DynamicResource Loc.WelcomeStart}" HorizontalAlignment="Right" Padding="24,12" Margin="0,8,0,0" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Start_Click"/>
  </StackPanel>
 </Grid></Border>
</Window>
