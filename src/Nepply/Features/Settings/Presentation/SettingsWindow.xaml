<Window x:Class="Nepply.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nepply.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Nepply · Cài đặt" Icon="/Nepply;component/Resources/icon.ico" Width="820" Height="740" MinWidth="520" MinHeight="500" WindowStartupLocation="CenterScreen" PreviewKeyDown="RecordKey" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource IslandBrush}">
 <Window.Resources>
  <ItemsPanelTemplate x:Key="SettingsRailPanel"><StackPanel/></ItemsPanelTemplate>
  <ItemsPanelTemplate x:Key="SettingsTabsPanel"><WrapPanel/></ItemsPanelTemplate>
 </Window.Resources>
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="16" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Grid Background="{DynamicResource IslandBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="TitleArea" Margin="26,20,18,18" Background="Transparent" MouseLeftButtonDown="DragTitle"><TextBlock x:Name="SettingsTitle" Text="{DynamicResource Loc.Settings}" FontSize="25" FontWeight="SemiBold"/><Button Content="&#xE8BB;" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Cancel_Click" ToolTip="{DynamicResource Loc.Close}"/></Grid>
  <Grid x:Name="SettingsBody" Grid.Row="1" SizeChanged="SettingsBody_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel x:Name="SearchArea" Grid.ColumnSpan="2" Margin="26,0,26,12">
    
    <Border x:Name="SettingsSearchHost" HorizontalAlignment="Left" CornerRadius="18" Background="Transparent" Padding="3" MouseEnter="SearchHost_Enter" MouseLeave="SearchHost_Leave">
     <StackPanel Orientation="Horizontal">
      <Button x:Name="SettingsSearchTrigger" Content="&#xE721;" Background="{DynamicResource CardBrush}" Style="{StaticResource IconButton}" Click="SettingsSearchTrigger_Click" ToolTip="{DynamicResource Loc.SearchSettingsTip}" AutomationProperties.Name="{DynamicResource Loc.SearchSettingsTip}"/>
      <TextBox x:Name="SearchSettings" Width="300" Visibility="Collapsed" MaxLength="120" Height="32" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource CardBrush}" BorderThickness="0" TextChanged="SearchSettings_Changed" KeyDown="SearchSettings_KeyDown" LostKeyboardFocus="SearchSettings_Unfocused" AutomationProperties.Name="{DynamicResource Loc.SearchSettingsTip}"/>
     </StackPanel>
    </Border>
   </StackPanel>
   <ListBox Grid.Row="1" x:Name="SettingsNavigation" SelectionChanged="SettingsNavigation_Changed" SelectedIndex="0" BorderThickness="0" Background="Transparent" Margin="26,0,22,14" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource Loc.SettingsSections}" ItemContainerStyle="{StaticResource SettingsNavigationItem}">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBoxItem Content="{DynamicResource Loc.Appearance}"/><ListBoxItem Content="{DynamicResource Loc.Panel}"/><ListBoxItem Content="{DynamicResource Loc.Desktop}"/><ListBoxItem Content="{DynamicResource Loc.Monitor}"/><ListBoxItem Content="{DynamicResource Loc.Application}"/><ListBoxItem Content="{DynamicResource Loc.Shortcuts}"/>
   </ListBox>
  <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" Grid.Column="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="SettingsContent" Margin="26,0,22,0">
    <Border x:Name="AppearanceSection" Style="{StaticResource SectionCard}" Margin="0,0,0,14" Padding="20"><StackPanel><TextBlock Text="{DynamicResource Loc.Appearance}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="{DynamicResource Loc.Language}" Style="{StaticResource Caption}" Margin="0,12,0,6"/><ComboBox x:Name="LanguageChoice" DisplayMemberPath="Name" SelectedValuePath="Id"/><TextBlock Text="{DynamicResource Loc.Theme}" Style="{StaticResource Caption}" Margin="0,12,0,6"/><ComboBox x:Name="ThemeChoice"/><TextBlock Text="{DynamicResource Loc.Materials}" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
     <ListBox x:Name="PaletteSwatches" Background="Transparent" BorderThickness="0" SelectedValuePath="Name" SelectedValue="{Binding SelectedItem, ElementName=AccentChoice, Mode=OneWay}" SelectionChanged="Palette_Selected" ItemContainerStyle="{StaticResource AccentSwatchItem}" AutomationProperties.Name="{DynamicResource Loc.Materials}">
      <ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}"><ItemsPresenter/></Border></ControlTemplate></ListBox.Template>
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
     </ListBox>
     <ComboBox x:Name="AccentChoice"/>
     <TextBlock Text="{DynamicResource Loc.CustomColor}" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
      <TextBox x:Name="CustomAccent" MaxLength="7" TextChanged="Hex_Changed"/>
      <Button x:Name="ColorButton" Grid.Column="1" Margin="8,0,0,0" Padding="0" Click="OpenColor_Click" ToolTip="{DynamicResource Loc.ColorPicker}"><Border x:Name="ColorPreview" Width="36" Height="30" CornerRadius="9"/></Button>
      <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="ColorPopup_Opened">
       <Border Background="{DynamicResource CardBrush}" CornerRadius="18" Padding="18" Margin="6" PreviewKeyDown="ColorPopup_KeyDown" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel><local:ColorField x:Name="ColorPicker" Width="280" Height="200" SelectionChanged="ColorPicker_Changed" AutomationProperties.Name="{DynamicResource Loc.ColorFieldHelp}"/>
         <TextBlock x:Name="RgbLabel" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/></StackPanel>
       </Border>
      </Popup>
     </Grid>
     <TextBlock Text="{DynamicResource Loc.Motion}" Style="{StaticResource Caption}" Margin="0,8,0,6"/>
     <ComboBox x:Name="MotionChoice"/>
     
     <CheckBox x:Name="MetallicEnabled" Content="{DynamicResource Loc.Metallic}"/>
     <CheckBox x:Name="NeonEnabled" Content="{DynamicResource Loc.Neon}"/>
     
     <CheckBox x:Name="DynamicMaterial" Content="{DynamicResource Loc.Sheen}" IsEnabled="{Binding ElementName=MetallicEnabled, Path=IsChecked}"/>
     <TextBlock Text="{DynamicResource Loc.Glow}" Style="{StaticResource Caption}"/><Slider x:Name="GlowSlider" IsEnabled="{Binding ElementName=NeonEnabled, Path=IsChecked}" Minimum="0" Maximum="50" IsMoveToPointEnabled="True"/><DockPanel Margin="0,12,0,0"><TextBlock Text="{DynamicResource Loc.Opacity}"/><TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:F0} %}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider x:Name="OpacitySlider" Minimum="80" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True"/></StackPanel></Border>
    <Border x:Name="PanelSection" Visibility="Collapsed" Style="{StaticResource SectionCard}" Margin="0,0,0,14" Padding="20"><StackPanel><TextBlock Text="{DynamicResource Loc.PanelZone}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="{DynamicResource Loc.Edge}" Style="{StaticResource Caption}" Margin="0,12,0,6"/><ComboBox x:Name="EdgeChoice"/><TextBlock Text="{DynamicResource Loc.Screen}" Style="{StaticResource Caption}" Margin="0,12,0,6"/><ComboBox x:Name="ScreenChoice" DisplayMemberPath="Name" SelectedValuePath="Id"/><DockPanel Margin="0,12,0,0"><TextBlock Text="{DynamicResource Loc.Width}"/><TextBlock Text="{Binding ElementName=WidthSlider, Path=Value, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider x:Name="WidthSlider" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True"/><DockPanel Margin="0,12,0,0"><TextBlock Text="{DynamicResource Loc.TopWidth}"/><TextBlock Text="{Binding ElementName=TopWidthSlider, Path=Value, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="TopWidthSlider" Minimum="0" Maximum="100"/>
<DockPanel Margin="0,12,0,0"><TextBlock Text="{DynamicResource Loc.TopHeight}"/><TextBlock Text="{Binding ElementName=HeightSlider, Path=Value, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider x:Name="HeightSlider" Minimum="0" Maximum="100" TickFrequency="20" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True"/><DockPanel Margin="0,12,0,0"><TextBlock Text="{DynamicResource Loc.TriggerZone}"/><TextBlock Text="{Binding ElementName=ZoneSlider, Path=Value, StringFormat={}{0:F0} DIP}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider x:Name="ZoneSlider" Minimum="2" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True"/><DockPanel Margin="0,12,0,0"><TextBlock Text="{DynamicResource Loc.TriggerDelay}"/><TextBlock Text="{Binding ElementName=DwellSlider, Path=Value, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider x:Name="DwellSlider" Minimum="0" Maximum="1000" TickFrequency="40" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True"/><DockPanel Margin="0,12,0,0"><TextBlock Text="{DynamicResource Loc.HideDelay}"/><TextBlock Text="{Binding ElementName=DelaySlider, Path=Value, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider x:Name="DelaySlider" Minimum="200" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True"/></StackPanel></Border>
    <Border x:Name="DesktopSection" Visibility="Collapsed" Style="{StaticResource SectionCard}" Margin="0,0,0,14" Padding="20"><StackPanel><TextBlock Text="{DynamicResource Loc.Desktop}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/><CheckBox x:Name="HideIcons" Content="{DynamicResource Loc.HideDesktop}"/><TextBlock Text="{DynamicResource Loc.DesktopRestore}" Style="{StaticResource Caption}" TextWrapping="Wrap"/><CheckBox x:Name="SingleClick" Content="{DynamicResource Loc.SingleClick}"/><CheckBox x:Name="HiddenFiles" Content="{DynamicResource Loc.HiddenFiles}"/><CheckBox x:Name="SystemIcons" Content="{DynamicResource Loc.SystemIcons}"/>
<CheckBox x:Name="MergeShortcuts" Content="{DynamicResource Loc.MergeShortcuts}" Margin="0,10,0,0"/>
<TextBlock x:Name="GridContext" Text="{DynamicResource Loc.IconGrid}" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,4"/>
<TextBlock Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"><TextBlock.Text><MultiBinding StringFormat="{}{0} × {1}"><Binding ElementName="GridPicker" Path="PreviewColumns"/><Binding ElementName="GridPicker" Path="PreviewRows"/></MultiBinding></TextBlock.Text></TextBlock>
<local:DotGridPicker x:Name="GridPicker" HorizontalAlignment="Stretch"/>
<TextBlock x:Name="GridAdvice" TextWrapping="Wrap" Margin="0,8,0,4" Style="{StaticResource Caption}"/>
<Button x:Name="GridRecommend" Content="{DynamicResource Loc.RecommendGrid}" Click="RecommendGrid_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
</StackPanel></Border>
    <Border x:Name="MonitorSection" Visibility="Collapsed" Style="{StaticResource SectionCard}" Margin="0,0,0,14" Padding="20"><StackPanel><TextBlock Text="{DynamicResource Loc.Hardware}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/><CheckBox x:Name="ShowMonitor" Content="{DynamicResource Loc.ShowMonitor}"/><CheckBox x:Name="ShowNetwork" Content="{DynamicResource Loc.ShowNetwork}"/><CheckBox x:Name="Sensors" Content="{DynamicResource Loc.Sensors}"/>
     <Button x:Name="DeveloperDiagnostics" Visibility="Collapsed" Content="{DynamicResource Loc.Diagnostics}" HorizontalAlignment="Left" Click="Diagnostics_Click" Margin="0,5,0,5"/>
     <TextBlock Text="{DynamicResource Loc.Device}" Style="{StaticResource Caption}" Margin="0,12,0,6"/><ComboBox x:Name="GpuModeChoice"/>
     <StackPanel x:Name="SelectedGpuOptions"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=GpuModeChoice}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="GPU" Style="{StaticResource Caption}" Margin="0,12,0,6"/><ComboBox x:Name="GpuChoice" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
     <StackPanel x:Name="SelectedIntegratedGpuOptions"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=GpuModeChoice}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="iGPU" Style="{StaticResource Caption}" Margin="0,12,0,6"/><ComboBox x:Name="IntegratedGpuChoice" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
     <TextBlock Text="{DynamicResource Loc.SensorHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"/><Expander x:Name="AdvancedMonitorOptions" Header="{DynamicResource Loc.Advanced}" Margin="0,12,0,0"><StackPanel><DockPanel Margin="0,12,0,0"><TextBlock Text="{DynamicResource Loc.Interval}"/><TextBlock Text="{Binding ElementName=IntervalSlider, Path=Value, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider x:Name="IntervalSlider" Minimum="1000" Maximum="10000" TickFrequency="500" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True"/><CheckBox x:Name="SuspendMonitor" Content="{DynamicResource Loc.Suspend}"/>

<CheckBox x:Name="EcoMode" Content="{DynamicResource Loc.Eco}"/><TextBlock Text="{DynamicResource Loc.NetworkAdapter}" Style="{StaticResource Caption}" Margin="0,12,0,6"/><ComboBox x:Name="NetworkChoice" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel></Expander></StackPanel></Border>
    <Border x:Name="ApplicationSection" Visibility="Collapsed" Style="{StaticResource SectionCard}" Margin="0,0,0,14" Padding="20"><StackPanel><TextBlock Text="{DynamicResource Loc.Background}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/><CheckBox x:Name="AutoStart" Content="{DynamicResource Loc.Startup}"/><TextBlock x:Name="AutoStartWindowsNotice" Visibility="Collapsed" Text="{DynamicResource Loc.AutoStartOffInWindows}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{DynamicResource Loc.Layouts}" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8"/>
     <ItemsControl x:Name="PresetCards" Margin="0,4,0,10" AutomationProperties.Name="{DynamicResource Loc.Layouts}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Tag="{Binding Id}" Click="Preset_Click" Margin="0,0,6,0" Padding="8,12" HorizontalContentAlignment="Stretch" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Name}">
        <StackPanel>
         <Grid Height="48" Margin="0,0,0,9" IsHitTestVisible="False">
          <Border Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" CornerRadius="6" Background="{DynamicResource AccentWashBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
           <UniformGrid Columns="2" Margin="5"><Ellipse Fill="{DynamicResource AccentBrush}" Width="4" Height="4"/><Ellipse Fill="{DynamicResource AccentBrush}" Width="4" Height="4"/><Ellipse Fill="{DynamicResource AccentBrush}" Width="4" Height="4"/><Ellipse Fill="{DynamicResource AccentBrush}" Width="4" Height="4"/></UniformGrid>
          </Border>
         </Grid>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </StackPanel>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     
     
     <WrapPanel Margin="0,12,0,0"><Button Content="{DynamicResource Loc.Export}" Click="ExportLayout_Click" Margin="0,0,8,8"/><Button Content="{DynamicResource Loc.Import}" Click="ImportLayout_Click" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock x:Name="ProfileStatus" TextWrapping="Wrap" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{DynamicResource Loc.About}" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8"/>
     <DockPanel><Image Width="40" Height="40" Margin="0,0,10,0" Source="/Nepply;component/Resources/nepply.png" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock x:Name="AboutVersion" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
     
     <WrapPanel><Button Content="{DynamicResource Loc.Privacy}" Tag="PRIVACY.md" Click="OpenLocalDocument_Click" Margin="0,0,8,8"/><Button Content="{DynamicResource Loc.ThirdParty}" Tag="THIRD_PARTY_NOTICES.md" Click="OpenLocalDocument_Click" Margin="0,0,8,8"/><Button x:Name="ReportProblemButton" Content="{DynamicResource Loc.ReportProblem}" Click="ReportProblem_Click" Margin="0,0,8,8"/><Button Content="{DynamicResource Loc.Support}" Click="OpenSupport_Click" Margin="0,0,0,8"/></WrapPanel>
     <WrapPanel Margin="0,4,0,8"><Button Content="{DynamicResource Loc.UpdateCheck}" Click="CheckUpdate_Click" Margin="0,0,8,0"/><Button x:Name="GuideButton" Content="{DynamicResource Loc.GuideOpen}" Click="Guide_Click" Margin="0,0,8,0"/><Button x:Name="CopyDiagnosticsButton" Content="{DynamicResource Loc.CopyDiagnostics}" Click="CopyDiagnostics_Click"/></WrapPanel>
     <CheckBox x:Name="AutoCheckUpdates" Content="{DynamicResource Loc.UpdateAutoCheck}" Margin="0,0,0,8"/>
     <TextBlock x:Name="InfoStatus" TextWrapping="Wrap" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></Border>
    <Border x:Name="ShortcutsSection" Visibility="Collapsed" Style="{StaticResource SectionCard}" Margin="0,0,0,14" Padding="20"><StackPanel>
     <TextBlock Text="{DynamicResource Loc.Shortcuts}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <TextBlock Text="{DynamicResource Loc.ShortcutsGlobal}" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
      <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.ShortcutTogglePanel}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/><Button x:Name="HotkeyButton" Grid.Column="1" Tag="TogglePanel" Click="Hotkey_Click" MinWidth="150"/><Button Grid.Column="2" Tag="TogglePanel" Click="ShortcutDefault_Click" Content="&#xE7A7;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutDefault}" AutomationProperties.Name="{DynamicResource Loc.ShortcutDefault}"/><Button Grid.Column="3" Tag="TogglePanel" Click="ShortcutClear_Click" Content="&#xE894;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutClear}" AutomationProperties.Name="{DynamicResource Loc.ShortcutClear}"/></Grid>
      <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.ShortcutSearchDesktop}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/><Button x:Name="ShortcutSearchDesktop" Grid.Column="1" Tag="SearchDesktop" Click="Hotkey_Click" MinWidth="150"/><Button Grid.Column="2" Tag="SearchDesktop" Click="ShortcutDefault_Click" Content="&#xE7A7;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutDefault}" AutomationProperties.Name="{DynamicResource Loc.ShortcutDefault}"/><Button Grid.Column="3" Tag="SearchDesktop" Click="ShortcutClear_Click" Content="&#xE894;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutClear}" AutomationProperties.Name="{DynamicResource Loc.ShortcutClear}"/></Grid>
      <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.ShortcutToggleDesktopIcons}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/><Button x:Name="ShortcutToggleDesktopIcons" Grid.Column="1" Tag="ToggleDesktopIcons" Click="Hotkey_Click" MinWidth="150"/><Button Grid.Column="2" Tag="ToggleDesktopIcons" Click="ShortcutDefault_Click" Content="&#xE7A7;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutDefault}" AutomationProperties.Name="{DynamicResource Loc.ShortcutDefault}"/><Button Grid.Column="3" Tag="ToggleDesktopIcons" Click="ShortcutClear_Click" Content="&#xE894;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutClear}" AutomationProperties.Name="{DynamicResource Loc.ShortcutClear}"/></Grid>
      <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.ShortcutTogglePin}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/><Button x:Name="ShortcutTogglePin" Grid.Column="1" Tag="TogglePin" Click="Hotkey_Click" MinWidth="150"/><Button Grid.Column="2" Tag="TogglePin" Click="ShortcutDefault_Click" Content="&#xE7A7;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutDefault}" AutomationProperties.Name="{DynamicResource Loc.ShortcutDefault}"/><Button Grid.Column="3" Tag="TogglePin" Click="ShortcutClear_Click" Content="&#xE894;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutClear}" AutomationProperties.Name="{DynamicResource Loc.ShortcutClear}"/></Grid>
      <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.ShortcutOpenSettings}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/><Button x:Name="ShortcutOpenSettings" Grid.Column="1" Tag="OpenSettings" Click="Hotkey_Click" MinWidth="150"/><Button Grid.Column="2" Tag="OpenSettings" Click="ShortcutDefault_Click" Content="&#xE7A7;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutDefault}" AutomationProperties.Name="{DynamicResource Loc.ShortcutDefault}"/><Button Grid.Column="3" Tag="OpenSettings" Click="ShortcutClear_Click" Content="&#xE894;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutClear}" AutomationProperties.Name="{DynamicResource Loc.ShortcutClear}"/></Grid>
     <TextBlock Text="{DynamicResource Loc.ShortcutsPanel}" Style="{StaticResource Caption}" Margin="0,16,0,4"/>
      <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.ShortcutFocusSearch}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/><Button x:Name="ShortcutFocusSearch" Grid.Column="1" Tag="FocusSearch" Click="Hotkey_Click" MinWidth="150"/><Button Grid.Column="2" Tag="FocusSearch" Click="ShortcutDefault_Click" Content="&#xE7A7;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutDefault}" AutomationProperties.Name="{DynamicResource Loc.ShortcutDefault}"/><Button Grid.Column="3" Tag="FocusSearch" Click="ShortcutClear_Click" Content="&#xE894;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutClear}" AutomationProperties.Name="{DynamicResource Loc.ShortcutClear}"/></Grid>
      <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.ShortcutRefreshDesktop}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/><Button x:Name="ShortcutRefreshDesktop" Grid.Column="1" Tag="RefreshDesktop" Click="Hotkey_Click" MinWidth="150"/><Button Grid.Column="2" Tag="RefreshDesktop" Click="ShortcutDefault_Click" Content="&#xE7A7;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutDefault}" AutomationProperties.Name="{DynamicResource Loc.ShortcutDefault}"/><Button Grid.Column="3" Tag="RefreshDesktop" Click="ShortcutClear_Click" Content="&#xE894;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Loc.ShortcutClear}" AutomationProperties.Name="{DynamicResource Loc.ShortcutClear}"/></Grid>
     <Button x:Name="ResetShortcuts" Content="{DynamicResource Loc.ShortcutsReset}" Click="ResetShortcuts_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
  <!-- Canvas measures no desired size: results cannot resize the form or navigation. -->
  <Canvas x:Name="SearchOverlayLayer" Grid.Row="2" Grid.Column="1" Panel.ZIndex="10" ClipToBounds="True" Margin="16,0,16,0" Visibility="Collapsed">
   <Border x:Name="SearchResultsSurface" Width="{Binding ActualWidth, ElementName=SearchOverlayLayer}" MaxHeight="{Binding ActualHeight, ElementName=SearchOverlayLayer}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="SearchHint" Visibility="Collapsed" Style="{StaticResource Caption}" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
    <ListBox x:Name="SearchResults" Grid.Row="1" MaxHeight="110" Visibility="Collapsed" KeyDown="SearchResults_KeyDown" AutomationProperties.Name="{DynamicResource Loc.SettingsSearchResults}" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Margin="0,6,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource SettingsSearchResultItem}">
     <ListBox.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="SearchResult_Click" Style="{StaticResource SettingsSearchResultAction}"><TextBlock Text="{Binding Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" TextWrapping="Wrap"/></Button></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    </Grid>
   </Border>
  </Canvas>
  </Grid>
  <Border x:Name="ActionArea" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Padding="26,16">
   <StackPanel><TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/><DockPanel>
    <Button Content="{DynamicResource Loc.Defaults}" Click="Reset_Click" DockPanel.Dock="Left"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource Loc.Cancel}" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True"/><Button x:Name="ApplyButton" Content="{DynamicResource Loc.Apply}" Click="Apply_Click" Margin="0,0,8,0" Padding="14,8"/><Button x:Name="OkButton" Content="{DynamicResource Loc.Ok}" Click="Save_Click" Style="{StaticResource PrimaryButton}" FontWeight="SemiBold" Padding="18,8" IsDefault="True"/></StackPanel>
   </DockPanel></StackPanel>
  </Border>
 </Grid>
</Window>
