<Window x:Class="Nepply.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Nepply.Views" Title="Nepply" Icon="/Nepply;component/Resources/icon.ico" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize" Loaded="Window_Loaded" PreviewKeyDown="Window_KeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <AdornerDecorator><Border x:Name="MainPanel" Background="{DynamicResource IslandBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="0.8" CornerRadius="{StaticResource RadiusIsland}">
  <Border.RenderTransform><TranslateTransform x:Name="PanelTranslate"/></Border.RenderTransform>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="PanelHeader" Margin="{StaticResource MarginPanelHeader}" Height="40" SizeChanged="PanelHeader_SizeChanged">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><Image x:Name="BrandTitle" Source="/Nepply;component/Resources/nepply.png" Width="36" Height="36" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Nepply" AutomationProperties.Name="Nepply"/><Border x:Name="BrandUnderline" Width="26" Height="3" Background="{DynamicResource AccentGradientBrush}" CornerRadius="2" HorizontalAlignment="Left" Margin="2,7,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4" VerticalAlignment="Center">
     <Button x:Name="DesktopSearchButton" Content="&#xE721;" Style="{StaticResource IconButton}" Click="DesktopSearch_Click" MouseEnter="DesktopSearch_Enter" MouseLeave="DesktopSearch_Leave" ToolTip="{DynamicResource Loc.SearchDesktopTip}" AutomationProperties.Name="{DynamicResource Loc.SearchDesktopTip}"/>
     <Button x:Name="EditLayoutButton" Content="&#xE70F;" Style="{StaticResource IconButton}" Click="EditLayout_Click" ToolTip="{DynamicResource Loc.EditTip}" AutomationProperties.Name="{DynamicResource Loc.EditLayout}"/>
     <ToggleButton x:Name="PinButton" Content="&#xE718;" Style="{StaticResource IconToggleButton}" Checked="Pin_StateChanged" Unchecked="Pin_StateChanged" ToolTip="{DynamicResource Loc.Pin}" AutomationProperties.Name="{DynamicResource Loc.Pin}"/>
     <Button x:Name="RefreshDesktopButton" Content="&#xE72C;" Style="{StaticResource IconButton}" Click="Refresh_Click" ToolTip="{DynamicResource Loc.Refresh}" AutomationProperties.Name="{DynamicResource Loc.Refresh}"/>
     <Button x:Name="PanelSettingsButton" Content="&#xE713;" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="{DynamicResource Loc.Settings}" AutomationProperties.Name="{DynamicResource Loc.Settings}"/>
    </StackPanel>
    <Border x:Name="DesktopSearchEditor" Visibility="Collapsed" MaxWidth="480" HorizontalAlignment="Stretch" Margin="0,0,12,0" Height="40" CornerRadius="20" Background="{DynamicResource CardBrush}" MouseEnter="DesktopSearch_Enter" MouseLeave="DesktopSearch_Leave">
     <Border.Style><Style TargetType="Border"><Setter Property="BorderThickness" Value="0.6"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></Style.Triggers></Style></Border.Style>
     <!-- The header search button stays beside the editor (highlighted while open), so the editor carries no second magnifier. -->
     <Grid Margin="16,0,7,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid>
       <TextBox x:Name="DesktopSearchBox" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" VerticalContentAlignment="Center" MinHeight="24" Text="{Binding DataContext.SearchQuery, ElementName=IconPanelView, UpdateSourceTrigger=PropertyChanged}" TextChanged="DesktopSearch_Changed" PreviewKeyDown="DesktopSearch_KeyDown" GotKeyboardFocus="DesktopSearch_Focused" LostKeyboardFocus="DesktopSearch_Unfocused" AutomationProperties.Name="{DynamicResource Loc.SearchDesktopTip}"/>
       <TextBlock Text="{DynamicResource Loc.SearchDesktop}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=DesktopSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <Button Grid.Column="1" Content="&#xE894;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="7" Margin="3,0,0,0" Background="Transparent" BorderThickness="0" Click="DesktopSearch_Clear" ToolTip="{DynamicResource Loc.ClearSearch}" AutomationProperties.Name="{DynamicResource Loc.ClearSearch}">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=DesktopSearchBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
     </Grid>
    </Border>
   </Grid>
   <Grid x:Name="ContentGrid" Grid.Row="1" SizeChanged="ContentGrid_SizeChanged">
    <ScrollViewer x:Name="MonitorScroller" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"><views:MonitorPanel x:Name="MonitorPanelView"/></ScrollViewer>
    <GridSplitter x:Name="ContentSeparator" Background="Transparent" Height="8" Margin="20,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" DragCompleted="ResizeLayout_End"><GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Border Background="Transparent"><Border x:Name="Grip" Background="{DynamicResource AccentBrush}" Height="2" Width="28" CornerRadius="1" Opacity=".4" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
     <ControlTemplate.Triggers><Trigger Property="ResizeDirection" Value="Columns"><Setter TargetName="Grip" Property="Width" Value="2"/><Setter TargetName="Grip" Property="Height" Value="28"/></Trigger></ControlTemplate.Triggers></ControlTemplate></GridSplitter.Template></GridSplitter>
    <views:IconPanel x:Name="IconPanelView"/>
   </Grid>
   <Border x:Name="PanelFooter" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Padding="20,11">
    <StackPanel>
     <Border x:Name="LayoutActions" Visibility="Collapsed" Background="{DynamicResource AccentWashBrush}" CornerRadius="12" Padding="10" Margin="0,0,0,8">
      <DockPanel LastChildFill="True">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{DynamicResource Loc.Cancel}" Click="CancelLayout_Click" Padding="10,6" Margin="0,0,6,0"/><Button Content="{DynamicResource Loc.Done}" Click="DoneLayout_Click" Padding="10,6" Style="{StaticResource PrimaryButton}"/></StackPanel>
       <Button x:Name="SwapSectionsButton" Content="{DynamicResource Loc.SwapSectionsShort}" Click="SwapSections_Click" HorizontalAlignment="Left" Padding="8,6" AutomationProperties.Name="{DynamicResource Loc.SwapSections}"/>
      </DockPanel>
     </Border>
    <DockPanel><TextBlock x:Name="FooterState" Visibility="Collapsed" Text="{DynamicResource Loc.Tagline}" Style="{StaticResource Caption}"/>
     <TextBlock x:Name="HotkeyText" Text="Ctrl + Space" Foreground="{DynamicResource AccentBrush}" FontSize="10" HorizontalAlignment="Right"/>
    </DockPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Border></AdornerDecorator>
</Window>
