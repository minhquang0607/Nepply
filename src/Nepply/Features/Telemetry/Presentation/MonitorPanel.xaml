<UserControl x:Class="Nepply.Views.MonitorPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nepply.Views">
 <UserControl.Resources>
  <Style x:Key="MonitorMetricCard" TargetType="Border" BasedOn="{StaticResource MetricCard}">
   <Setter Property="Height" Value="{Binding CardHeight, RelativeSource={RelativeSource AncestorType=local:MonitorPanel}}"/>
   <Setter Property="Margin" Value="6,0,6,14"/><Setter Property="Padding" Value="11,9"/><Setter Property="CornerRadius" Value="17"/>
  </Style>
 </UserControl.Resources>
 <StackPanel>
  <Border x:Name="StaleNotice" Margin="18,4,18,8" Padding="10,8" CornerRadius="10" Background="{DynamicResource AccentWashBrush}" Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}">
   <TextBlock Text="{DynamicResource Loc.Stale}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="11" AutomationProperties.LiveSetting="Polite" ToolTip="{Binding StatusText}"/>
  </Border>
  <StackPanel x:Name="Widgets" Margin="18,14,18,14">
   <UniformGrid x:Name="SummaryGrid" Columns="2" Tag="summary">
<Border Style="{StaticResource MonitorMetricCard}" ToolTip="{Binding CpuDetails}">
 <local:MetricReadingView Label="CPU" ValueText="{Binding CpuLoadText}" SecondaryText="{Binding CpuTempText}" Load="{Binding CpuLoad}" Footnote="{Binding CpuClockText}"/>
</Border>
<Border Style="{StaticResource MonitorMetricCard}" ToolTip="{Binding RamDetails}">
 <local:MetricReadingView Label="RAM" ValueText="{Binding RamLoadText}" Load="{Binding RamLoad}" Footnote="{Binding RamInfoText}"/>
</Border>
   </UniformGrid>
   <ItemsControl x:Name="GpuCards" Tag="gpus" ItemsSource="{Binding Gpus}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding GpuColumns, RelativeSource={RelativeSource AncestorType=local:MonitorPanel}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
<Border Style="{StaticResource MonitorMetricCard}" ToolTip="{Binding Details}">
 <local:MetricReadingView Label="{Binding Label}" ValueText="{Binding LoadText}" SecondaryText="{Binding TemperatureText}" Load="{Binding LoadValue}" Footnote="{Binding ClockText}"/>
</Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <TextBlock Text="{DynamicResource Loc.GpuUnavailable}" ToolTip="{Binding SensorNote}" Margin="3,8,0,0" FontSize="10" Foreground="{DynamicResource MutedBrush}">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Gpus.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <Border x:Name="NetworkCard" Tag="network" Background="{DynamicResource CardBrush}" CornerRadius="17" Padding="12,8" Margin="6,2,6,0" BorderThickness="0.5" BorderBrush="{DynamicResource BorderBrush}">
    <StackPanel>
     <TextBlock Text="{Binding NetworkName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding NetworkName}" Margin="0,0,0,4"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="15"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid ToolTip="{DynamicResource Loc.Download}" AutomationProperties.Name="{DynamicResource Loc.Download}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="↓" Foreground="{DynamicResource AccentBrush}" FontSize="15" Margin="0,0,6,0"/><TextBlock Grid.Column="1" Text="{Binding NetDownloadText}" Style="{StaticResource NumericText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding NetDownloadText}"/></Grid>
      <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Margin="0,2"/>
      <Grid Grid.Column="2" ToolTip="{DynamicResource Loc.Upload}" AutomationProperties.Name="{DynamicResource Loc.Upload}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="↑" Foreground="{DynamicResource AccentBrush}" FontSize="15" Margin="0,0,6,0"/><TextBlock Grid.Column="1" Text="{Binding NetUploadText}" Style="{StaticResource NumericText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding NetUploadText}"/></Grid>
     </Grid>
    </StackPanel>
   </Border>
  </StackPanel>
 </StackPanel>
</UserControl>
